# NEW session start with nvim on first window and bash on second window by Default
set-hook -g after-new-session 'send-keys "nvim" Enter ; new-window ; select-window -t :1'

# Prefix: Ctrl-a instead of Ctrl-b
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Start windows and panes at 1
set -g base-index 1
setw -g pane-base-index 1

# Renumber windows when one is closed, so there are no gaps
set -g renumber-windows on
